{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(index.html|app.js|styles.css|sw.js|firebase-messaging-sw.js|firebase-config.js|fcm-client.js|manifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/subscription-trials",
      "schedule": "0 0 * * *"
    }
  ]
}